# Copy to .env (git-ignored). Each secret may instead be supplied as a file
# path via the *_FILE variant, e.g. QBO_CLIENT_SECRET_FILE=./secrets/client_secret

# "sandbox" (default) or "production". Use the matching keys from the Intuit
# developer portal: Development keys for sandbox, Production keys for production.
QBO_ENVIRONMENT=sandbox

QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Must exactly match a Redirect URI registered on the app's Keys page.
# Sandbox default: http://localhost:8765/callback (local listener).
# Production default: Intuit's OAuth Playground URL (paste-the-URL flow), because
# production redirect URIs must be HTTPS and may not be localhost.
# QBO_REDIRECT_URI=

# Optional overrides
# QBO_MINOR_VERSION=75
# QBO_STATE_DIR=          # where encrypted tokens live (default: ~/Library/Application Support/qbo-export)
# QBO_LOG_LEVEL=warn      # console log level; never logs tokens or customer data
